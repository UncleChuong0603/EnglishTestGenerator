# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase trusted server key. Never prefix this with NEXT_PUBLIC_.
# Use only in server-side generation and scoring code.
SUPABASE_SECRET_KEY=

# OpenAI server-only configuration
OPENAI_API_KEY=
OPENAI_MODEL=
# Copy this file to .env.local and add values from your Supabase project settings.
# Do not commit .env.local or any real credentials.

# These are public client settings, safe to use in browser code.
# Do not use the Supabase service-role key in a NEXT_PUBLIC_ variable.

# Safe to expose to the browser. Used by the future Supabase browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
