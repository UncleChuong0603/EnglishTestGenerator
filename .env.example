SESSION_SECRET=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=English Test <noreply@example.com>
SMTP_SECURE=false
# Keep false for Reading-only local development. Production Listening requires complete R2 values.
