DATABASE_URL=postgresql://english_test:change_me@postgres:5432/english_test
SESSION_SECRET=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth is optional; configure both values or neither. Local auth remains available.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=English Test <noreply@example.com>
SMTP_SECURE=false
# LOCAL is the production target; R2 remains available for migration and rollback.
MEDIA_ENABLED=false
MEDIA_STORAGE_PROVIDER=LOCAL
LOCAL_MEDIA_ROOT=/var/lib/toeicgym/media
MEDIA_SIGNING_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Reserved for a future controlled CONTENT CDN; signed URLs are the current strategy.
R2_PUBLIC_BASE_URL=

# Server-only payments. Empty prices keep those products unavailable.
PAYMENT_PROVIDER=PAYOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PREMIUM_30_PRICE_VND=
PREMIUM_90_PRICE_VND=
PREMIUM_365_PRICE_VND=

# Optional trusted content-authoring environment only; never used by the application runtime.
OPENAI_API_KEY=
CONTENT_TTS_MODEL=gpt-4o-mini-tts
CONTENT_TTS_PROVIDER=edge
# Dedicated-server Compose credentials
POSTGRES_DB=english_test
POSTGRES_USER=english_test
POSTGRES_PASSWORD=
# Dokploy Compose credentials (use DATABASE_URL with this app role)
POSTGRES_ADMIN_USER=toeicgym_admin
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_USER=toeicgym_app
APP_DATABASE_PASSWORD=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
NGINX_CONFIG=http.conf.template
BACKUP_DIR=/opt/toeic-app/backups
