{
  "name": "english-test-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:ranked-challenges:migrate": "node scripts/task16c-migrate.mjs",
    "test:integration:ranked-challenges:reset": "node scripts/task16c-reset.mjs",
    "test:integration:ranked-challenges": "node --conditions=react-server --import tsx scripts/task16c-integration.mts",
    "test:integration:ranked-challenges:matrix": "node --conditions=react-server --import tsx scripts/task16d-matrix.mts",
    "test:integration:ranked-challenges:archive": "node --conditions=react-server --import tsx scripts/task16d-archive-matrix.mts",
    "test:e2e:ranked-challenges:seed": "node --conditions=react-server --import tsx scripts/task16c-browser-seed.mts",
    "test:e2e:ranked-challenges": "playwright test e2e/ranked-challenges.spec.ts",
    "test:integration:payments": "node --env-file=.env.task16.local --conditions=react-server --import tsx scripts/task17b-integration.mts",
    "test:e2e:payments": "node --env-file=.env.task16.local scripts/task17b-playwright.mjs",
    "test:e2e:blog:seed": "node --env-file=.env.local scripts/task18b-browser-seed.mjs",
    "test:e2e:blog": "node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/blog-cms.spec.ts",
    "payments:preflight": "node --env-file-if-exists=.env.local scripts/payments-preflight.mjs",
    "payments:clear-test-data": "node --env-file-if-exists=.env.local scripts/clear-payment-test-data.mjs",
    "production:preflight": "node --env-file-if-exists=.env.local scripts/production-preflight.mjs",
    "production:verify": "node --env-file-if-exists=.env.local scripts/production-verify.mjs",
    "task23:verify:production": "node --env-file-if-exists=.env.local scripts/task23-verify-production.mjs",
    "task22:verify:postgres": "node scripts/task22-verify-postgres.mjs",
    "task22:verify:postgres:cleanup": "docker compose -f docker-compose.test.yml down --remove-orphans",
    "test:integration:task27": "node --conditions=react-server --import tsx scripts/task27-integration.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:legacy": "node --env-file=.env.local scripts/migrate-supabase-data.mjs",
    "db:migrate:legacy:production": "node scripts/migrate-supabase-data.mjs",
    "validate:i18n": "vitest run src/lib/i18n/translations.test.ts",
    "validate:part5": "node scripts/validate-part5-seed.mjs",
    "seed:part5": "node --env-file=.env.local scripts/seed-part5.mjs",
    "verify:part5": "node --env-file=.env.local scripts/seed-part5.mjs --verify-only",
    "validate:reading": "node scripts/validate-reading-seed.mjs",
    "validate:listening": "node scripts/validate-listening-seed.mjs",
    "content:listening:validate": "node --conditions=react-server --import tsx scripts/content-pipeline.ts validate",
    "content:listening:generate-media": "node --conditions=react-server --import tsx scripts/content-pipeline.ts generate-media",
    "content:listening:regenerate-media": "node --conditions=react-server --import tsx scripts/content-pipeline.ts generate-media --force",
    "content:listening:publish": "node --conditions=react-server --env-file=.env.local --import tsx scripts/content-pipeline.ts publish",
    "content:listening:publish:dry-run": "node --conditions=react-server --env-file=.env.local --import tsx scripts/content-pipeline.ts publish --dry-run",
    "content:listening:report": "node --conditions=react-server --import tsx scripts/content-pipeline.ts report",
    "content:reading:validate": "node scripts/validate-reading-seed.mjs",
    "content:reading:publish": "node --env-file=.env.local scripts/seed-reading.mjs",
    "content:validate-import": "tsx scripts/validate-question-import.ts",
    "media:preflight": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/media-operator.mts preflight",
    "media:status": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/media-operator.mts status",
    "media:verify": "node --env-file-if-exists=.env.local scripts/media-verify.mjs",
    "media:finalize-local": "node --env-file-if-exists=.env.local scripts/finalize-local-media.mjs",
    "validate:mock-readiness": "node --env-file=.env.local scripts/validate-mock-readiness.mjs",
    "seed:reading": "node --env-file=.env.local scripts/seed-reading.mjs",
    "verify:reading": "node --env-file=.env.local scripts/seed-reading.mjs --verify-only",
    "seed:reading:production": "node scripts/seed-reading.mjs",
    "verify:reading:production": "node scripts/seed-reading.mjs --verify-only",
    "verify:production-db": "node scripts/verify-production-db.mjs",
    "verify:smtp": "node scripts/verify-smtp.mjs",
    "plan:inspect": "node --conditions=react-server --env-file=.env.local --import tsx scripts/plan-operator.ts inspect",
    "plan:grant": "node --conditions=react-server --env-file=.env.local --import tsx scripts/plan-operator.ts grant",
    "plan:revoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/plan-operator.ts revoke",
    "admin:inspect": "node --conditions=react-server --env-file=.env.local --import tsx scripts/admin-operator.ts inspect",
    "admin:grant": "node --conditions=react-server --env-file=.env.local --import tsx scripts/admin-operator.ts grant",
    "admin:revoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/admin-operator.ts revoke"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "image-size": "^2.0.4",
    "next": "^16.0.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "ffmpeg-static": "^5.3.0",
    "node-edge-tts": "^1.2.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
