import { access, mkdir, readdir, stat, statfs, writeFile, rm } from "node:fs/promises";
import path from "node:path";

const provider=process.env.MEDIA_STORAGE_PROVIDER??"LOCAL", root=process.env.LOCAL_MEDIA_ROOT;
async function walk(dir:string):Promise<{count:number;bytes:number}>{let count=0,bytes=0;for(const e of await readdir(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory()){const x=await walk(p);count+=x.count;bytes+=x.bytes}else if(e.isFile()&&!e.name.endsWith(".tmp")){count++;bytes+=(await stat(p)).size}}return{count,bytes}}
async function localState(){if(!root)return null;await mkdir(root,{recursive:true,mode:0o750});await access(root);const probe=path.join(root,`.preflight-${process.pid}`);await writeFile(probe,"ok",{mode:0o640});await rm(probe);const usage=await walk(root),fs=await statfs(root);return{...usage,freeBytes:fs.bavail*fs.bsize}}
const command=process.argv[2]??"preflight";try{if(provider!=="LOCAL")throw new Error("MEDIA_STORAGE_PROVIDER_MUST_BE_LOCAL");const local=await localState();console.log(`Environment: ${process.env.NODE_ENV??"development"}`);console.log(`Provider: ${provider}`);console.log(`Media root: ${root?"CONFIGURED":"NOT CONFIGURED"}`);console.log(`Readable/Writable: ${local?"YES":"NO"}`);console.log(`Signing secret: ${process.env.MEDIA_SIGNING_SECRET?"CONFIGURED":"NOT CONFIGURED"}`);console.log("Protected delivery: ENABLED");if(command==="status"&&local){console.log(`Assets: ${local.count}`);console.log(`Media bytes: ${local.bytes}`);console.log(`Free bytes: ${local.freeBytes}`)}}catch{console.error("Media preflight failed: storage is not readable and writable");process.exitCode=1}
