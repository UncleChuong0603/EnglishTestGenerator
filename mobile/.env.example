# Public URL only. Do not put secrets in EXPO_PUBLIC_* variables.
# Android emulator local default (this line may be omitted in development):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Public OAuth web client ID used as the audience of native Google ID tokens.
# Register net.toeicgym.app with both upload-key and Play App Signing SHA-1.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Private build-time file path supplied by an EAS file-secret environment
# variable. Never use EXPO_PUBLIC_* and never commit google-services.json.
# GOOGLE_SERVICES_JSON=C:\secure\google-services.json

# Staging example:
# EXPO_PUBLIC_API_URL=https://staging.example.com/api/v1

# Production is built in as https://toeicgym.net/api/v1; an override is not
# required for a production release.
